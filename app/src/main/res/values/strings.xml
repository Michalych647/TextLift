    <string name="engine_title">Translation engine</string>
    <string name="engine_hint">Choose what does the translating. The built-in engine runs on this device; the others send the recognized text to a service you configure with your own API key.</string>
    <string name="engine_on_device">On-device (ML Kit)</string>
    <string name="engine_on_device_summary">Free, private, works offline. Translates sentence by sentence.</string>
    <string name="engine_deepl">DeepL</string>
    <string name="engine_deepl_summary">Natural wording, strong on European languages. Needs a DeepL API key.</string>
    <string name="engine_google">Google Cloud Translation</string>
    <string name="engine_google_summary">The widest language coverage. Needs a Google Cloud API key.</string>
    <string name="engine_openai">LLM (custom / OpenAI-compatible)</string>
    <string name="engine_openai_summary">Translates the whole screen at once, so wording stays consistent. OpenAI, Gemini, DeepSeek, OpenRouter, Groq, Mistral, Together, a local Ollama or LM Studio — or any other endpoint you type in.</string>
    <string name="engine_anthropic">Claude (Anthropic)</string>
    <string name="engine_anthropic_summary">Translates the whole screen at once; good with interface wording and short labels.</string>
