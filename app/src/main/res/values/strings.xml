    <string name="a11y_setup_summary">Enable TextLift under accessibility so the tile can capture the screen</string>
    <string name="a11y_label">TextLift screen capture</string>
    <string name="a11y_description">Takes a screenshot when you tap the tile or use the assistant gesture, and keeps TextLift running so captures open instantly. It receives no accessibility events, does not read window content and does not observe your input.</string>
