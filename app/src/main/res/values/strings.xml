    <string name="engine_needs_key">%1$s needs an API key. Set it up under Translation engine.</string>
    <string name="engine_key_help_deepl">Create a key at deepl.com/pro-api — the free tier allows 500,000 characters a month. Free keys end in “:fx”.</string>
    <string name="engine_key_help_google">Enable the Cloud Translation API in Google Cloud and create an API key. Billed per character.</string>
    <string name="engine_key_help_openai">Works with any service that speaks OpenAI\'s /chat/completions API. Tap a preset, or type your own endpoint and model name. A server running on this device (Ollama, LM Studio) needs no key.</string>
    <string name="engine_key_help_anthropic">Create a key at console.anthropic.com. A small, fast model is plenty for translation.</string>
